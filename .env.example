# Going Home needs NO API keys.
#
# Every agent runs on a Claude subscription through the Claude Code CLI (`claude -p`).
# Before the first run: install Claude Code, run `claude` once in a terminal, and log in
# with /login using an account whose plan includes Claude Code. Any ANTHROPIC_API_KEY in
# the environment is ignored on purpose, so calls can never switch to metered API billing.
#
# Mode: auto (default) = live if Claude Code is logged in, otherwise demo mode, which replays
# real recorded runs. Force one with live or demo.
# GOING_HOME_MODE=auto
#
# This file is optional. If you create a .env (in this folder or the folder above it),
# you can change these settings:

# Models per agent (Claude Code CLI aliases: opus, sonnet, haiku)
# READER_MODEL=opus
# CHECKER_MODEL=sonnet
# EXPLAINER_MODEL=sonnet
# TRANSCRIBER_MODEL=sonnet

# Safety and spending limits
# MAX_TOKENS_PER_RUN=150000
# MAX_LLM_CALLS_PER_RUN=8
# MAX_RUNS_PER_DAY=40
# MAX_USD_PER_CALL=0.60
# MAX_UPLOAD_MB=10
# MAX_PAGES=10
